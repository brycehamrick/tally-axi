{
  "$schema": "https://axi.md/schema/integration.json",
  "name": "tally",
  "displayName": "Tally",
  "description": "Read forms and submissions and manage webhooks through the Tally API.",
  "version": "1.0.0",
  "runtime": "node",
  "entrypoint": "dist/index.js",
  "environment": {
    "TALLY_API_KEY": {
      "description": "Tally API key used as a Bearer token.",
      "required": true,
      "secret": true
    },
    "TALLY_API_BASE_URL": {
      "description": "Optional API base URL override.",
      "required": false,
      "default": "https://api.tally.so"
    }
  },
  "tools": "dist/tools.json"
}
