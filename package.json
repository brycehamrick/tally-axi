{
  "name": "tally-axi",
  "version": "1.0.0",
  "description": "An AXI integration for the public Tally API",
  "type": "module",
  "bin": {
    "tally-axi": "dist/index.js"
  },
  "files": [
    "axi.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.js",
    "format:check": "node scripts/check-format.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.js",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.28.1"
}
